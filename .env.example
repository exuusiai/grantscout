GRANTSCOUT_ENVIRONMENT=development
GRANTSCOUT_LOG_LEVEL=INFO
GRANTSCOUT_DATA_DIR=data
GRANTSCOUT_RUNS_DIR=runs

# OpenAI-compatible local inference server.
GRANTSCOUT_MODEL_BASE_URL=http://127.0.0.1:8001/v1
GRANTSCOUT_MODEL_API_KEY=EMPTY
GRANTSCOUT_MODEL_NAME=Qwen/Qwen3-8B
# The vLLM startup script defaults to /root/autodl-tmp/models/Qwen-Qwen3-8B.
# Set this only when the verified local model is stored elsewhere.
# GRANTSCOUT_MODEL_PATH=/root/autodl-tmp/models/Qwen-Qwen3-8B
GRANTSCOUT_MODEL_TIMEOUT_SECONDS=120
GRANTSCOUT_MODEL_MAX_TOKENS=2048
GRANTSCOUT_MODEL_TEMPERATURE=0.2
# When true, use the local model for question decomposition and fact extraction.
# Invalid or failed model output falls back to the deterministic offline path.
GRANTSCOUT_USE_MODEL_REASONING=false

# Retrieval defaults to the dependency-free lexical baseline. Set semantic
# after installing `pip install -e '.[retrieval]'` and building the index.
GRANTSCOUT_RETRIEVAL_MODE=lexical
GRANTSCOUT_EMBEDDING_MODEL=BAAI/bge-m3
GRANTSCOUT_VECTOR_INDEX_PATH=data/vector.index
GRANTSCOUT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
GRANTSCOUT_USE_RERANKER=false

# Phase 0 safety limits. Later phases will consume these centrally.
GRANTSCOUT_MAX_STEPS=12
GRANTSCOUT_MAX_TOOL_CALLS=24
GRANTSCOUT_MAX_PAPERS=20
GRANTSCOUT_MAX_RETRIES=2
