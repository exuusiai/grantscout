PAPERSCOUT_ENVIRONMENT=development
PAPERSCOUT_LOG_LEVEL=INFO
PAPERSCOUT_DATA_DIR=data
PAPERSCOUT_RUNS_DIR=runs

# OpenAI-compatible local inference server.
PAPERSCOUT_MODEL_BASE_URL=http://127.0.0.1:8001/v1
PAPERSCOUT_MODEL_API_KEY=EMPTY
PAPERSCOUT_MODEL_NAME=Qwen/Qwen3-8B
# The vLLM startup script defaults to /root/autodl-tmp/models/Qwen-Qwen3-8B.
# Set this only when the verified local model is stored elsewhere.
# PAPERSCOUT_MODEL_PATH=/root/autodl-tmp/models/Qwen-Qwen3-8B
PAPERSCOUT_MODEL_TIMEOUT_SECONDS=120
PAPERSCOUT_MODEL_MAX_TOKENS=2048
PAPERSCOUT_MODEL_TEMPERATURE=0.2
# When true, use the local model for question decomposition and fact extraction.
# Invalid or failed model output falls back to the deterministic offline path.
PAPERSCOUT_USE_MODEL_REASONING=false

# Retrieval defaults to the dependency-free lexical baseline. Set semantic
# after installing `pip install -e '.[retrieval]'` and building the index.
PAPERSCOUT_RETRIEVAL_MODE=lexical
PAPERSCOUT_EMBEDDING_MODEL=BAAI/bge-m3
PAPERSCOUT_VECTOR_INDEX_PATH=data/vector.index
PAPERSCOUT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
PAPERSCOUT_USE_RERANKER=false

# Phase 0 safety limits. Later phases will consume these centrally.
PAPERSCOUT_MAX_STEPS=12
PAPERSCOUT_MAX_TOOL_CALLS=24
PAPERSCOUT_MAX_PAPERS=20
PAPERSCOUT_MAX_RETRIES=2
